/.bundle/
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/tmp/

# Library — bundler resolution belongs to consumers, not the gem
/Gemfile.lock
/gemfiles/*.lock

# rbs collection — installed sigs and the derived lock float with the
# (uncommitted) Gemfile.lock; only rbs_collection.yaml is tracked.
/.gem_rbs_collection/
/rbs_collection.lock.yaml

# rspec failure tracking
.rspec_status

# Allows local overriding of mise.toml
# see: https://mise.jdx.dev/configuration.html#mise-toml
/mise.local.toml

# IDEA
.idea/

# Scrap files
/scrap
