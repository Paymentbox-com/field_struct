{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sigs-check.sh\"",
            "timeout": 60,
            "statusMessage": "Checking sig/field_struct.rbs is current (rake sigs:check)"
          }
        ]
      }
    ]
  }
}
