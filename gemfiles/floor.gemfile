# frozen_string_literal: true

# Minimal dependency set for the Ruby-floor CI job. The gem's *runtime* deps
# (oj, bigdecimal) support Ruby >= 3.0 — what required_ruby_version advertises —
# but the dev toolchain in the main Gemfile (rbs/sord, which need Ruby >= 3.2)
# does not. This gemfile pulls only the gemspec runtime deps plus rspec, so the
# floor job can run the library's specs on Ruby 3.0/3.1 to prove the gem itself
# works there. Run with `BUNDLE_GEMFILE=gemfiles/floor.gemfile bundle exec rspec`.
source 'https://rubygems.org'

gemspec path: '..'

gem 'rspec', '~> 3.0'
